{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/user", "destination": "/user.html" },
    { "source": "/dashboard", "destination": "/user.html" },
    { "source": "/(.*)", "destination": "/api/index.js" }
  ]
}
